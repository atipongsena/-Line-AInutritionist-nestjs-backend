{
  "platform": {
    "apiRuntime": "node:20"
  },
  "navigationFallback": {
    "rewrite": "/"
  },
  "routes": [
    {
      "route": "/manifest.json",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*.png",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*.ico",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "responseOverrides": {
    "400": {
      "rewrite": "/",
      "statusCode": 200
    },
    "401": {
      "redirect": "/",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/",
      "statusCode": 200
    },
    "404": {
      "rewrite": "/",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "X-XSS-Protection": "1; mode=block",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:; frame-ancestors 'self' https://*.line.me https://*.line-apps.com https://*.line-scdn.net; connect-src 'self' https://*.line.me https://*.line-scdn.net https://api.line.me; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.line-scdn.net;"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".png": "image/png",
    ".ico": "image/x-icon"
  }
}

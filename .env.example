# 🔧 AI Nutritionist Environment Variables Template
# คัดลอกไฟล์นี้เป็น .env และแก้ไขค่าต่างๆ ให้ถูกต้อง

# =============================================================================
# 🖥️  Server Configuration
# =============================================================================
NODE_ENV=development
PORT=3001

# =============================================================================
# 🗄️  Database Configuration (MongoDB)
# =============================================================================
DATABASE_URL=mongodb://localhost:27017/ai_food
# สำหรับ MongoDB Atlas:
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/ai_food

# =============================================================================
# 📱 LINE API Configuration
# =============================================================================
# ได้จาก LINE Developers Console: https://developers.line.biz/
LINE_CHANNEL_ACCESS_TOKEN="YOUR_LINE_CHANNEL_ACCESS_TOKEN"
LINE_CHANNEL_SECRET="YOUR_LINE_CHANNEL_SECRET"

# =============================================================================
# 🤖 Azure OpenAI Configuration
# =============================================================================
# Azure OpenAI Service endpoint
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"

# Deployment names (สร้างใน Azure OpenAI Studio)
AZURE_OPENAI_DEPLOYMENT_NAME_GPT4_1="gpt-4-deployment-name"
AZURE_OPENAI_DEPLOYMENT_NAME_GPT4_1_MINI="gpt-4-mini-deployment-name"

# API versions
AZURE_OPENAI_API_VERSION="2024-04-01-preview"
AZURE_OPENAI_EMBEDDING_API_VERSION="2023-05-15"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME="text-embedding-ada-002"

# =============================================================================
# 🔐 Azure Authentication (Service Principal)
# =============================================================================
# สร้างจาก: az ad sp create-for-rbac --name "ai-nutritionist-sp" --role contributor
AZURE_CLIENT_ID="your-azure-ad-app-client-id"
AZURE_TENANT_ID="your-azure-ad-tenant-id"
AZURE_CLIENT_SECRET="your-azure-ad-app-client-secret"

# =============================================================================
# 💾 Azure Storage Configuration
# =============================================================================
# ได้จาก Azure Portal > Storage Account > Access keys
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=yourkey;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="food-images"

# =============================================================================
# 🔑 Security & API Keys
# =============================================================================
# สำหรับ internal API calls (ถ้ามี)
INTERNAL_API_KEY="your-internal-api-key-if-needed"

# JWT Secret (สำหรับ authentication ถ้ามี)
JWT_SECRET="your-jwt-secret-key"

# =============================================================================
# 🌐 CORS & External URLs
# =============================================================================
# Frontend URLs ที่อนุญาตให้เข้าถึง API
CORS_ORIGINS="http://localhost:3000,https://your-frontend-domain.com"

# Webhook URL สำหรับ LINE (ถ้าใช้ ngrok ใน development)
# WEBHOOK_URL="https://your-ngrok-url.ngrok.io"

# =============================================================================
# 📊 Monitoring & Logging
# =============================================================================
# Log level: error, warn, info, debug
LOG_LEVEL="info"

# Enable request logging
ENABLE_REQUEST_LOGGING="true"

# Application Insights connection string (ถ้าใช้)
# APPINSIGHTS_CONNECTION_STRING="InstrumentationKey=your-key"

# =============================================================================
# 🔧 Performance & Caching
# =============================================================================
# Cache TTL in seconds
CACHE_TTL="3600"

# Request timeout in milliseconds
REQUEST_TIMEOUT="30000"

# Max file upload size in bytes (10MB)
MAX_FILE_SIZE="10485760"

# =============================================================================
# 🏥 Health Check & Monitoring
# =============================================================================
# Health check endpoint path
HEALTH_CHECK_PATH="/health"

# Enable detailed health checks
ENABLE_DETAILED_HEALTH_CHECKS="true"

# =============================================================================
# 🧪 Development & Testing
# =============================================================================
# Enable debug logs
DEBUG="false"

# Mock external services in development
MOCK_EXTERNAL_SERVICES="false"

# Test database (ใช้เฉพาะเมื่อรัน tests)
TEST_DATABASE_URL="mongodb://localhost:27017/ai_food_test"

# =============================================================================
# 📝 Notes
# =============================================================================
# 
# การตั้งค่าสำหรับ Production:
# 1. เปลี่ยน NODE_ENV เป็น "production"
# 2. ใช้ HTTPS URLs ทั้งหมด
# 3. ตั้งค่า strong JWT_SECRET
# 4. เปิดใช้งาน monitoring tools
# 5. ตรวจสอบ CORS settings
# 
# การตั้งค่าสำหรับ Development:
# 1. ใช้ ngrok สำหรับ webhook testing
# 2. เปิดใช้งาน debug logs
# 3. ใช้ local MongoDB
# 
# สำหรับ deployment บน Azure:
# - ตั้งค่า environment variables ใน Azure Container Apps
# - ใช้ Azure Key Vault สำหรับ sensitive data
# - เปิดใช้งาน Application Insights สำหรับ monitoring 